package com.onlinemedicalstore.webbasedmedicineorderingsystem.repository;

import com.onlinemedicalstore.webbasedmedicineorderingsystem.entity.Prescription;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;
import java.util.List;

@Repository
public interface PrescriptionRepository extends JpaRepository<Prescription, Long> {
    List<Prescription> findByUserUsername(String username);
}