package com.onlinemedicalstore.webbasedmedicineorderingsystem.repository;

import com.onlinemedicalstore.webbasedmedicineorderingsystem.entity.Payment;
import com.onlinemedicalstore.webbasedmedicineorderingsystem.entity.PaymentStatus;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;
import java.time.LocalDateTime;
import java.util.List;

@Repository
public interface PaymentRepository extends JpaRepository<Payment, Long> {
    List<Payment> findByStatusAndCreationDateBefore(PaymentStatus status, LocalDateTime time);
}
