<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders - PharmaGo</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100">
<nav class="bg-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
            <div class="flex">
                <div class="flex-shrink-0 flex items-center font-bold text-xl text-blue-600">
                    PharmaGo
                </div>
                <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
                    <a href="/store.html" class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">Store</a>
                    <a href="/my_orders.html" class="border-blue-500 text-gray-900 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">My Orders</a>
                    <a href="/profile.html" class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">My Profile</a>
                </div>
            </div>
            <div class="flex items-center">
                <form id="logout-form" action="/logout" method="post">
                    <button type="submit" class="ml-4 px-3 py-1 bg-red-500 text-white text-sm font-semibold rounded-md hover:bg-red-600 transition">Logout</button>
                </form>
            </div>
        </div>
    </div>
</nav>

<div class="container max-w-5xl mx-auto p-4 sm:p-8">
    <header class="text-center mb-10">
        <h1 class="text-4xl font-bold text-slate-700">My Order History</h1>
        <p class="text-slate-500 mt-2">Here is a list of all your past orders.</p>
    </header>

    <div id="orders-container" class="space-y-6"></div>
</div>

<!-- Review Modal -->
<div id="review-modal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
    <div class="relative top-20 mx-auto p-5 border w-full max-w-md shadow-lg rounded-md bg-white">
        <div class="mt-3 text-center">
            <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">Leave a Review</h3>
            <form id="review-form" class="mt-2 space-y-4 text-left p-4">
                <input type="hidden" id="medicine-id-for-review">
                <div>
                    <label class="block text-sm font-medium text-slate-600 mb-2">Rating</label>
                    <div class="flex justify-center items-center space-x-1" id="star-rating">
                        <!-- Stars will be generated by JavaScript -->
                    </div>
                </div>
                <div>
                    <label for="comment" class="block text-sm font-medium text-slate-600">Comment</label>
                    <textarea id="comment" rows="4" class="w-full border rounded-md p-2 mt-1" placeholder="Write your review here..."></textarea>
                </div>
                <div id="review-message" class="text-sm text-center"></div>
                <div class="items-center px-4 py-3 space-y-2">
                    <button id="submit-review-btn" type="submit" class="w-full px-4 py-2 bg-blue-600 text-white text-base font-medium rounded-md shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        Submit Review
                    </button>
                    <button id="close-modal-btn" type="button" class="w-full px-4 py-2 bg-gray-200 text-gray-800 text-base font-medium rounded-md shadow-sm hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    const ordersContainer = document.getElementById('orders-container');
    const reviewModal = document.getElementById('review-modal');
    const reviewForm = document.getElementById('review-form');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const starRatingContainer = document.getElementById('star-rating');
    const modalTitle = document.getElementById('modal-title');
    const medicineIdField = document.getElementById('medicine-id-for-review');
    const commentField = document.getElementById('comment');
    const reviewMessage = document.getElementById('review-message');
    let currentRating = 0;

    async function checkAuthAndFetchOrders() {
        try {
            const authResponse = await fetch('/api/auth/me');
            if (!authResponse.ok) {
                window.location.href = '/login.html';
                return;
            }
            const ordersResponse = await fetch('/api/orders/my-orders');
            if (!ordersResponse.ok) {
                throw new Error("Could not fetch your orders.");
            }
            const orders = await ordersResponse.json();
            renderOrders(orders);
        } catch (error) {
            ordersContainer.innerHTML = `<p class="text-center text-red-500">${error.message}</p>`;
        }
    }

    function renderOrders(orders) {
        ordersContainer.innerHTML = '';
        if (orders.length === 0) {
            ordersContainer.innerHTML = '<p class="text-center text-gray-500">You have not placed any orders yet.</p>';
            return;
        }

        orders.reverse().forEach(order => {
            const orderCard = document.createElement('div');
            orderCard.className = 'bg-white p-6 rounded-xl shadow-md';
            const orderItemsHtml = order.orderItems.map(item => `
                <div class="flex justify-between items-center py-2 border-b">
                    <div>
                        <span class="font-medium">${item.medicine.name}</span>
                        <span class="text-gray-500 text-xs block">${item.quantity} x Rs.${item.price.toFixed(2)}</span>
                    </div>
                    <button onclick="openReviewModal(${item.medicine.id}, '${item.medicine.name.replace(/'/g, "\\'")}')" class="text-xs px-2 py-1 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 transition">Leave a Review</button>
                </div>`).join('');

            orderCard.innerHTML = `
                <div class="flex justify-between items-center mb-4">
                    <div>
                        <h3 class="font-bold text-lg">Order #${order.id}</h3>
                        <span class="text-sm text-gray-500">${new Date(order.orderDate).toLocaleString()}</span>
                    </div>
                    <button onclick="cancelOrder(${order.id})" class="px-3 py-1 bg-red-500 text-white text-sm font-semibold rounded-md hover:bg-red-600 transition">
                        Cancel Order
                    </button>
                </div>
                <div class="space-y-2 mb-4">${orderItemsHtml}</div>
                <div class="text-right font-bold text-xl text-blue-600">Total: Rs.${order.totalPrice.toFixed(2)}</div>`;
            ordersContainer.appendChild(orderCard);
        });
    }

    async function cancelOrder(orderId) {
        if (!confirm('Are you sure you want to cancel this order?')) { return; }
        try {
            const response = await fetch(`/api/orders/${orderId}`, { method: 'DELETE' });
            if (!response.ok) {
                throw new Error(await response.text() || 'Failed to cancel the order.');
            }
            alert('Order cancelled successfully!');
            checkAuthAndFetchOrders();
        } catch (error) {
            alert(error.message);
        }
    }

    function openReviewModal(medicineId, medicineName) {
        modalTitle.textContent = `Leave a Review for ${medicineName}`;
        medicineIdField.value = medicineId;
        reviewModal.classList.remove('hidden');
        renderStars(0);
    }

    function closeReviewModal() {
        reviewModal.classList.add('hidden');
        reviewForm.reset();
        currentRating = 0;
        reviewMessage.textContent = '';
        reviewMessage.className = 'text-sm text-center';
    }

    function renderStars(rating) {
        starRatingContainer.innerHTML = '';
        for (let i = 1; i <= 5; i++) {
            const star = document.createElement('span');
            star.innerHTML = '⭐';
            star.className = `cursor-pointer text-3xl transition-opacity ${i <= rating ? 'opacity-100' : 'opacity-30 hover:opacity-70'}`;
            star.dataset.value = i;
            star.onclick = () => {
                currentRating = i;
                renderStars(i);
            };
            starRatingContainer.appendChild(star);
        }
    }

    closeModalBtn.onclick = closeReviewModal;

    reviewForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (currentRating === 0) {
            reviewMessage.textContent = 'Please select a star rating.';
            reviewMessage.className = 'text-red-500 text-center text-sm';
            return;
        }

        const payload = {
            medicineId: parseInt(medicineIdField.value),
            rating: currentRating,
            comment: commentField.value
        };

        const response = await fetch('/api/reviews', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        if (response.ok) {
            reviewMessage.textContent = 'Review submitted successfully!';
            reviewMessage.className = 'text-green-500 text-center text-sm';
            setTimeout(closeReviewModal, 2000);
        } else {
            reviewMessage.textContent = `Error: ${await response.text()}`;
            reviewMessage.className = 'text-red-500 text-center text-sm';
        }
    });


    document.addEventListener('DOMContentLoaded', checkAuthAndFetchOrders);
</script>
</body>
</html>

