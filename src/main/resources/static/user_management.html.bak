<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Management - PharmaGo</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 text-slate-800">
<nav class="bg-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
            <div class="flex">
                <div class="flex-shrink-0 flex items-center font-bold text-xl text-blue-600">PharmaGo Admin</div>
                <div class="hidden sm:ml-6 sm:flex sm:space-x-8" id="nav-links"></div>
            </div>
            <div class="hidden sm:ml-6 sm:flex sm:items-center" id="nav-user"></div>
        </div>
    </div>
</nav>

<div class="container max-w-6xl mx-auto p-4 sm:p-8">
    <header class="text-center mb-10">
        <h1 class="text-4xl font-bold text-slate-700">User Management</h1>
        <p class="text-slate-500 mt-2">Create, update, and remove all users.</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-1 bg-white p-6 rounded-xl shadow-md">
            <h2 class="text-2xl font-semibold text-slate-700 mb-5">Manage User</h2>
            <form id="user-form" class="space-y-4">
                <input type="hidden" id="user-id">
                <div>
                    <label for="username" class="block text-sm font-medium">Username</label>
                    <input type="text" id="username" required class="w-full p-2 border rounded-md mt-1">
                </div>
                <div>
                    <label for="email" class="block text-sm font-medium">Email</label>
                    <input type="email" id="email" required class="w-full p-2 border rounded-md mt-1">
                </div>
                <div id="password-section">
                    <label for="password" class="block text-sm font-medium">Password</label>
                    <input type="password" id="password" required class="w-full p-2 border rounded-md mt-1" placeholder="Required for new users">
                </div>
                <div>
                    <label for="role" class="block text-sm font-medium">Role</label>
                    <select id="role" required class="w-full p-2 border rounded-md mt-1">
                        <option value="ROLE_CUSTOMER">Customer</option>
                        <option value="ROLE_INVENTORY_MANAGER">Inventory Manager</option>
                        <option value="ROLE_FINANCE_OFFICER">Finance Officer</option>
                        <option value="ROLE_GENERAL_PHYSICIAN">General Physician</option>
                        <option value="ROLE_PHARMACY_ASSISTANT">Pharmacy Assistant</option>
                        <option value="ROLE_DELIVERY_COORDINATOR">Delivery Coordinator</option>
                        <option value="ROLE_SUPER_ADMIN">Super Admin</option>
                    </select>
                </div>
                <div class="flex justify-end space-x-3 pt-2">
                    <button type="button" id="clear-btn" class="px-4 py-2 bg-slate-500 text-white rounded-md">Clear</button>
                    <button type="submit" id="save-btn" class="px-4 py-2 bg-blue-600 text-white rounded-md">Save User</button>
                </div>
            </form>
        </div>

        <div class="lg:col-span-2 space-y-8" id="tables-container">
            <div class="bg-white p-6 rounded-xl shadow-md">
                <h2 class="text-2xl font-semibold text-slate-700 mb-5">Admin Users</h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left">
                        <thead class="text-xs text-slate-700 uppercase bg-slate-50">
                        <tr>
                            <th class="px-6 py-3">Username</th>
                            <th class="px-6 py-3">Email</th>
                            <th class="px-6 py-3">Role</th>
                            <th class="px-6 py-3 text-center">Actions</th>
                        </tr>
                        </thead>
                        <tbody id="admins-body"></tbody>
                    </table>
                </div>
            </div>

            <div class="bg-white p-6 rounded-xl shadow-md">
                <h2 class="text-2xl font-semibold text-slate-700 mb-5">Customer Users</h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left">
                        <thead class="text-xs text-slate-700 uppercase bg-slate-50">
                        <tr>
                            <th class="px-6 py-3">Username</th>
                            <th class="px-6 py-3">Email</th>
                            <th class="px-6 py-3 text-center">Actions</th>
                        </tr>
                        </thead>
                        <tbody id="customers-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function checkAuth() {
        try {
            const response = await fetch('/api/auth/me');
            if (!response.ok) { window.location.href = '/login.html'; return; }
            const user = await response.json();
            if (user.role !== 'ROLE_SUPER_ADMIN') {
                alert("Access Denied: This page is for Super Admins only.");
                window.location.href = '/admin_dashboard.html';
                return;
            }
            populateNav(user);
        } catch (error) { window.location.href = '/login.html'; }
    }

    function populateNav(user) {
        const navLinks = document.getElementById('nav-links');
        const navUser = document.getElementById('nav-user');
        navUser.innerHTML = `<span class="text-sm mr-4">Logged in as ${user.username}</span><form action="/logout" method="post"><button type="submit" class="px-3 py-1 bg-red-500 text-white rounded-md">Logout</button></form>`;
        navLinks.innerHTML = `
            <a href="/admin_dashboard.html" class="border-transparent text-gray-500 inline-flex items-center px-1 pt-1 border-b-2 text-sm">Dashboard</a>
            <a href="/inventory.html" class="border-transparent text-gray-500 inline-flex items-center px-1 pt-1 border-b-2 text-sm">Inventory</a>
            <a href="/orders.html" class="border-transparent text-gray-500 inline-flex items-center px-1 pt-1 border-b-2 text-sm">Orders</a>
            <a href="/user_management.html" class="border-blue-500 text-gray-900 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium">User Management</a>
        `;
    }

    document.addEventListener('DOMContentLoaded', () => {
        checkAuth();

        const userForm = document.getElementById('user-form');
        const adminsBody = document.getElementById('admins-body');
        const customersBody = document.getElementById('customers-body');
        const tablesContainer = document.getElementById('tables-container');
        const userIdField = document.getElementById('user-id');
        const usernameField = document.getElementById('username');
        const emailField = document.getElementById('email');
        const passwordField = document.getElementById('password');
        const passwordSection = document.getElementById('password-section');
        const roleField = document.getElementById('role');
        const clearBtn = document.getElementById('clear-btn');
        const saveBtn = document.getElementById('save-btn');

        const fetchUsers = async () => {
            const response = await fetch('/api/users/all');
            const users = await response.json();
            adminsBody.innerHTML = '';
            customersBody.innerHTML = '';

            users.forEach(user => {
                const row = document.createElement('tr');
                row.className = 'bg-white border-b';

                if (user.role === 'ROLE_CUSTOMER') {
                    row.innerHTML = `
                        <td class="px-6 py-4 font-medium">${user.username}</td>
                        <td class="px-6 py-4">${user.email}</td>
                        <td class="px-6 py-4 text-center">
                            <button class="font-medium text-yellow-600 mr-3 edit-btn" data-id="${user.id}">Edit</button>
                            <button class="font-medium text-red-600 delete-btn" data-id="${user.id}">Delete</button>
                        </td>`;
                    customersBody.appendChild(row);
                } else {
                    row.innerHTML = `
                        <td class="px-6 py-4 font-medium">${user.username}</td>
                        <td class="px-6 py-4">${user.email}</td>
                        <td class="px-6 py-4">${user.role.replace('ROLE_', '')}</td>
                        <td class="px-6 py-4 text-center">
                            <button class="font-medium text-yellow-600 mr-3 edit-btn" data-id="${user.id}">Edit</button>
                            <button class="font-medium text-red-600 delete-btn" data-id="${user.id}">Delete</button>
                        </td>`;
                    adminsBody.appendChild(row);
                }
            });
        };

        const clearForm = () => {
            userForm.reset();
            userIdField.value = '';
            passwordSection.style.display = 'block';
            passwordField.required = true;
            saveBtn.textContent = 'Save User';
        };

        userForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const id = userIdField.value;
            const payload = {
                username: usernameField.value,
                email: emailField.value,
                role: roleField.value,
            };
            if (!id) {
                payload.password = passwordField.value;
            }

            const method = id ? 'PUT' : 'POST';
            const url = id ? `/api/users/${id}` : '/api/users';

            const response = await fetch(url, {
                method,
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(payload)
            });

            if (response.ok) {
                clearForm();
                fetchUsers();
            } else {
                alert(`Error: ${await response.text()}`);
            }
        });

        tablesContainer.addEventListener('click', async (e) => {
            const { target } = e;
            const id = target.dataset.id;
            if (!id) return;

            if (target.classList.contains('edit-btn')) {
                const response = await fetch('/api/users/all');
                const users = await response.json();
                const user = users.find(u => u.id == id);
                if (user) {
                    userIdField.value = user.id;
                    usernameField.value = user.username;
                    emailField.value = user.email;
                    roleField.value = user.role;
                    passwordSection.style.display = 'none';
                    passwordField.required = false;
                    saveBtn.textContent = 'Update User';
                    userForm.scrollIntoView({ behavior: 'smooth' });
                }
            }
            if (target.classList.contains('delete-btn')) {
                if (confirm('Are you sure you want to delete this user? This action is permanent.')) {
                    const response = await fetch(`/api/users/${id}`, { method: 'DELETE' });
                    if (response.ok) {
                        fetchUsers();
                    } else {
                        alert(`Error: ${await response.text()}`);
                    }
                }
            }
        });

        clearBtn.addEventListener('click', clearForm);
        fetchUsers();
    });
</script>
</body>
</html>